{
  "$schema": "https://turbo.build/schema.json",
  "version": "2",
  "tasks": {
    "lint": {
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": ["coverage"],
      "cache": false
    },
    "build": {
      "outputs": ["dist", "build"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
