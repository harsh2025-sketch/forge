# JWT Scanner environment variables (documentation only — never commit real values).
# See docs/SETUP.md and docs/PROVIDERS.md.

# Database (required for db:migrate and DATA_MODE=postgres)
DATABASE_URL=postgres://user:password@localhost:5432/forge

# Runtime modes (deterministic test seams — no credentials needed)
# AUTH_MODE=test
# BILLING_MODE=test
# DATA_MODE=memory

# Authentication (live mode — Clerk)
CLERK_SECRET_KEY=
AUTH_SIGN_IN_URL=https://accounts.example.test/sign-in

# Billing (live mode — Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Application
APP_URL=http://localhost:3000
