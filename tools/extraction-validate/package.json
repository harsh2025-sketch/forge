{
  "name": "@forge/extraction-validate",
  "version": "0.0.1",
  "description": "Forge V3 extraction validation gate \u2014 validates product structure, manifest, provider isolation, documentation, and delegates architecture enforcement",
  "private": true,
  "type": "module",
  "bin": {
    "forge-extraction-validate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "check": "node dist/cli.js --root ../.."
  },
  "dependencies": {
    "@forge/architecture-check": "workspace:*",
    "@forge/config": "workspace:*",
    "@forge/create-product": "workspace:*",
    "@forge/extract-product": "workspace:*",
    "@forge/validate-docs": "workspace:*",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "vitest": "^1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
