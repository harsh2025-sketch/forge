{
  "name": "@forge/validate-docs",
  "version": "0.0.1",
  "description": "Forge V3 framework and product documentation validation",
  "private": true,
  "type": "module",
  "bin": {
    "forge-validate-docs": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "check": "node dist/cli.js --root ../.."
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
