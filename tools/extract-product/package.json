{
  "name": "@forge/extract-product",
  "version": "0.0.1",
  "description": "Forge V3 extraction tool \u2014 imports an existing application into the Forge product structure with deterministic classification and reporting",
  "private": true,
  "type": "module",
  "bin": {
    "forge-extract-product": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && vitest run",
    "check": "node dist/check.js"
  },
  "dependencies": {
    "@forge/config": "workspace:*",
    "@forge/create-product": "workspace:*",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "vitest": "^3.2.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
