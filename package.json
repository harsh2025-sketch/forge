{
  "name": "forge",
  "version": "0.0.1",
  "description": "Master SaaS Framework for building independent acquisition-ready SaaS products",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.21.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "arch-check": "pnpm --filter @forge/architecture-check build && pnpm --filter @forge/architecture-check check",
    "audit": "pnpm audit --audit-level=high",
    "build": "turbo run build",
    "create-product": "pnpm --filter @forge/create-product build && node tools/create-product/dist/cli.js --root .",
    "dev": "turbo run dev",
    "extract-product": "pnpm --filter @forge/extract-product build && node tools/extract-product/dist/cli.js",
    "extraction-validate": "pnpm --filter @forge/extraction-validate build && node tools/extraction-validate/dist/cli.js --root .",
    "lint": "turbo run lint",
    "prepare": "pnpm setup-hooks",
    "setup-hooks": "git config core.hooksPath .githooks",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "pnpm arch-check && pnpm validate-docs && pnpm lint && pnpm typecheck && pnpm test",
    "validate-docs": "pnpm --filter @forge/validate-docs build && pnpm --filter @forge/validate-docs check"
  },
  "keywords": [
    "saas",
    "framework",
    "typescript",
    "monorepo"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@playwright/test": "^1.40.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
